# Web
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_BASE_URL=https://example.com
NEXT_STATIC_HOST=https://example.com/static
NEXT_REVALIDATE_SECONDS=600

# Worker
WORKER_ENV=production
DEFAULT_PODCAST_VARIANT=hacker-news
TIMEZONE_OFFSET=8
TIMEZONE_NAME=Asia/Taipei
RUN_DAILY_CRON=5 7 * * *
QUEUE_PREFIX=daily-podcast-host
QUEUE_CONCURRENCY=1
QUEUE_JOB_ATTEMPTS=5
QUEUE_JOB_BACKOFF_MS=10000

# OpenAI
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_THINKING_MODEL=
OPENAI_MAX_TOKENS=8192
OPENAI_MAX_COMPLETION_TOKENS=32768
OPENAI_TTS_API_KEY=
OPENAI_TTS_BASE_URL=
OPENAI_TTS_MODEL=
OPENAI_TTS_INSTRUCTIONS=

# Content fetchers
JINA_KEY=
FIRECRAWL_KEY=
MAX_STORY_BUDGET=

# TTS
TTS_PROVIDER=edge-tts
TTS_API_URL=
TTS_API_ID=
TTS_API_KEY=
TTS_MODEL=
MAN_VOICE_ID=
WOMAN_VOICE_ID=
AUDIO_SPEED=1.0
GEMINI_TTS_API_KEY=
GEMINI_TTS_MODEL=

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=daily_podcast
POSTGRES_USER=daily_podcast
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://daily_podcast:change-me@postgres:5432/daily_podcast

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379

# MinIO / S3
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=podcast-audio
S3_FORCE_PATH_STYLE=true
MINIO_CONSOLE_PORT=9001

# Reverse proxy
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
LETSENCRYPT_EMAIL=ops@example.com
